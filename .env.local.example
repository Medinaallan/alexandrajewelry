# Copy this file to .env.local and fill in the API URL

# Local dev (wrangler dev default port)
VITE_API_URL=http://localhost:8787

# Production (set this in Vercel dashboard, not here)
# VITE_API_URL=https://alexandra-api.your-user.workers.dev

# Store's WhatsApp number (country code + number, digits only)
VITE_WHATSAPP_NUMBER=14137709901

# PayPal Client ID (public). Live in Vercel; leave empty locally or use a Sandbox one
# so local tests never charge real money.
VITE_PAYPAL_CLIENT_ID=
